generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  APPROVED
  HIDDEN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id              String         @id @default(uuid())
  full_name       String
  email           String         @unique
  password_hash   String
  phone           String?
  profile_picture String?
  bio             String?
  country         String?
  language        String?
  role            Role           @default(STUDENT)
  status          UserStatus     @default(ACTIVE)
  created_at      DateTime       @default(now())
  last_login      DateTime?

  // Relations
  courses_taught  Course[]       @relation("InstructorCourses")
  enrollments     Enrollment[]
  orders          Order[]
  reviews         Review[]
  wishlist        Wishlist?
  cart            Cart?
  certificates    Certificate[]
  notifications   Notification[]
}

model Category {
  id         String   @id @default(uuid())
  name       String
  icon       String?
  created_at DateTime @default(now())

  // Relations
  courses    Course[]
}

model Course {
  id                 String       @id @default(uuid())
  instructor_id      String
  category_id        String
  title              String
  description        String
  thumbnail          String?
  preview_video      String?
  price              Float
  discount_price     Float?
  level              String?
  language           String?
  requirements       String[]     // Array of strings
  learning_outcomes  String[]     // Array of strings
  status             CourseStatus @default(DRAFT)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  // Relations
  instructor         User         @relation("InstructorCourses", fields: [instructor_id], references: [id])
  category           Category     @relation(fields: [category_id], references: [id])
  sections           Section[]
  enrollments        Enrollment[]
  reviews            Review[]
  order_items        OrderItem[]
  wishlist_items     WishlistItem[]
  cart_items         CartItem[]
  certificates       Certificate[]
}

model Section {
  id             String   @id @default(uuid())
  course_id      String
  title          String
  sequence_order Int

  // Relations
  course         Course   @relation(fields: [course_id], references: [id])
  lessons        Lesson[]

  @@index([course_id, sequence_order])
}

model Lesson {
  id              String   @id @default(uuid())
  section_id      String
  title           String
  duration        Int      // Duration in minutes or seconds
  video_url       String?
  is_free_preview Boolean  @default(false)
  sequence_order  Int

  // Relations
  section         Section  @relation(fields: [section_id], references: [id])
  course_progress CourseProgress[]
  lesson_progress LessonProgress[]

  @@index([section_id, sequence_order])
}

model Enrollment {
  id                  String   @id @default(uuid())
  student_id          String
  course_id           String
  progress_percentage Float    @default(0.0)
  enrolled_at         DateTime @default(now())
  completed_at        DateTime?

  // Relations
  student             User     @relation(fields: [student_id], references: [id])
  course              Course   @relation(fields: [course_id], references: [id])
  course_progress     CourseProgress?
  lesson_progress     LessonProgress[]

  @@unique([student_id, course_id])
}

model Order {
  id           String      @id @default(uuid())
  student_id   String
  coupon_id    String?
  subtotal     Float
  discount     Float       @default(0.0)
  total_price  Float
  status       OrderStatus @default(PENDING)
  created_at   DateTime    @default(now())

  // Relations
  student      User        @relation(fields: [student_id], references: [id])
  coupon       Coupon?     @relation(fields: [coupon_id], references: [id])
  items        OrderItem[]
  payment      Payment?
}

model OrderItem {
  id        String @id @default(uuid())
  order_id  String
  course_id String
  price     Float

  // Relations
  order     Order  @relation(fields: [order_id], references: [id])
  course    Course @relation(fields: [course_id], references: [id])
}

model Payment {
  id              String        @id @default(uuid())
  order_id        String        @unique
  payment_method  String
  status          PaymentStatus @default(PENDING)
  transaction_id  String?
  created_at      DateTime @default(now())

  // Relations
  order           Order    @relation(fields: [order_id], references: [id])
}

model Review {
  id         String       @id @default(uuid())
  course_id  String
  student_id String
  rating     Int          // E.g., 1 to 5
  comment    String?
  status     ReviewStatus @default(APPROVED)
  created_at DateTime     @default(now())

  // Relations
  course     Course       @relation(fields: [course_id], references: [id])
  student    User         @relation(fields: [student_id], references: [id])
}

model Wishlist {
  id         String         @id @default(uuid())
  student_id String         @unique

  // Relations
  student    User           @relation(fields: [student_id], references: [id])
  items      WishlistItem[]
}

model WishlistItem {
  id          String   @id @default(uuid())
  wishlist_id String
  course_id   String
  created_at  DateTime @default(now())

  // Relations
  wishlist    Wishlist @relation(fields: [wishlist_id], references: [id])
  course      Course   @relation(fields: [course_id], references: [id])

  @@unique([wishlist_id, course_id])
}

model Cart {
  id         String     @id @default(uuid())
  student_id String     @unique

  // Relations
  student    User       @relation(fields: [student_id], references: [id])
  items      CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cart_id   String
  course_id String

  // Relations
  cart      Cart   @relation(fields: [cart_id], references: [id])
  course    Course @relation(fields: [course_id], references: [id])

  @@unique([cart_id, course_id])
}

model Coupon {
  id                  String   @id @default(uuid())
  code                String   @unique
  discount_percentage Float
  expiration_date     DateTime
  usage_limit         Int?
  used_count          Int      @default(0)

  // Relations
  orders              Order[]
}

model Certificate {
  id         String   @id @default(uuid())
  student_id String
  course_id  String
  issue_date DateTime @default(now())
  pdf_url    String

  // Relations
  student    User     @relation(fields: [student_id], references: [id])
  course     Course   @relation(fields: [course_id], references: [id])

  @@unique([student_id, course_id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  // Relations
  user       User     @relation(fields: [user_id], references: [id])
}

model CourseProgress {
  id                     String     @id @default(uuid())
  enrollment_id          String     @unique
  last_watched_lesson_id String?

  // Relations
  enrollment             Enrollment @relation(fields: [enrollment_id], references: [id])
  last_watched_lesson    Lesson?    @relation(fields: [last_watched_lesson_id], references: [id])
}

model LessonProgress {
  id            String     @id @default(uuid())
  enrollment_id String
  lesson_id     String
  is_completed  Boolean    @default(false)
  watch_position Int       @default(0)
  completed_at  DateTime?

  // Relations
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id])
  lesson        Lesson     @relation(fields: [lesson_id], references: [id])

  @@unique([enrollment_id, lesson_id])
}
